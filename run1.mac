# AmBe decomposition example macro
/control/verbose 1
/run/verbose 0
/event/verbose 0
/tracking/verbose 0

/run/initialize

# Choose source mode: gamma | neutron | full
/NaI/source/mode full
/NaI/source/gammaEnergy 4438 keV
/NaI/source/gammaPerNeutron 5.75e-3
/NaI/source/sourceRadius 0 mm

# Experimental peak window for 4.438 MeV analysis
/NaI/analysis/peakCenter 4438 keV
/NaI/analysis/peakHalfWidth 120 keV
/NaI/analysis/applyResolutionSmearing true
/NaI/analysis/resolutionRefEnergy 4438 keV
/NaI/analysis/resolutionRefFwhmFraction 0.055

/run/beamOn 500000
